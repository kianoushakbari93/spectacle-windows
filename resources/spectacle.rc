#pragma code_page(65001)

#include <winres.h>

#define SPECTACLE_VERSION_BINARY 3,0,0,0
#define SPECTACLE_VERSION_STRING "3.0.0.0"

1 ICON "spectacle.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "spectacle.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SPECTACLE_VERSION_BINARY
 PRODUCTVERSION SPECTACLE_VERSION_BINARY
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Spectacle"
            VALUE "FileDescription", "Spectacle"
            VALUE "FileVersion", SPECTACLE_VERSION_STRING
            VALUE "InternalName", "Spectacle"
            VALUE "LegalCopyright", "Copyright (c) 2017 Eric Czarny / 2026 Kianoush Akbari"
            VALUE "OriginalFilename", "Spectacle.exe"
            VALUE "ProductName", "Spectacle"
            VALUE "ProductVersion", SPECTACLE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
